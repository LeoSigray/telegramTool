# Virtual environment
.venv/

# Telethon sessions — рабочая директория (кэш из БД, не коммитить)
*.session
*.session-journal
sessions/
tdata_accounts/

# Account credentials
accounts/*.txt

# БД с аккаунтами, прокси и настройками (приватные данные — не коммитить!)
# Для переноса на новую машину скопируй вручную: data/database.db
data/database.db
data/database.db-shm
data/database.db-wal

# Прокси (теперь в БД, файл оставлен для обратной совместимости)
proxy.txt

# Excel данные и рантайм
data/targets.xlsx
# ...и любые резервные копии базы контактов — в них те же тысячи реальных
# юзернеймов живых людей, в репозиторий им нельзя
data/targets.xlsx.bak*
data/*.bak-*
data/daily_usage.json

# Умный парсинг (parsing/smart): кеш сообщений, профили клиентов и отчёты с людьми
data/smart_parser.db
data/smart_parser.db-shm
data/smart_parser.db-wal
data/smart_profiles/
data/smart_leads/

# Python cache
__pycache__/
*.pyc
*.pyo

# IDE
.idea/
.vscode/

# macOS
.DS_Store

# API token
.env

# avatar cache (runtime)
avatars_cache/
