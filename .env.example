# telegramTool API — общий секрет, которым клиенты (мобильное приложение) авторизуются.
API_TOKEN=

# Опционально: куда пушить входящие сообщения от tool-аккаунтов.
# Если задано, listener при старте подключает все sessions/ и шлёт каждое
# входящее личное сообщение в этот URL POST'ом.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# Хост/порт API (опционально)
API_HOST=0.0.0.0
API_PORT=9000

# Gemini — для bulk-генерации имён/фамилий на профилях
# Получить ключ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
