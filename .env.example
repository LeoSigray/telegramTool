# --- LZT.market ---
# Токен API: lzt.market → Настройки → API. Требуется активный market-доступ +
# заданный пароль безопасности аккаунта, иначе API отвечает заглушкой
# «Вы должны установить пароль, чтобы продолжить».
LZT_TOKEN=
LZT_MARKET_ID=24
LZT_API_BASE_URL=https://prod-api.lzt.market

# --- Telegram (my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# telegramTool API — общий секрет, которым клиенты (десктоп-приложение) авторизуются.
# Необязательно: если оставить пустым, бэкенд сам сгенерирует токен при первом
# запуске и сохранит в ~/.telegramtool/token — десктоп-приложение прочитает
# его оттуда сам, вводить руками не придётся (см. api/auth.py).
API_TOKEN=

# Опционально: куда пушить входящие сообщения от tool-аккаунтов.
# Если задано, listener при старте подключает все sessions/ и шлёт каждое
# входящее личное сообщение в этот URL POST'ом.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# Хост/порт API (опционально)
API_HOST=0.0.0.0
API_PORT=9000

# Диалоги (/inbox): по умолчанию чат заводится только на ОТВЕТ на рассылку.
# Поставь 1, чтобы заводить чат на ЛЮБОЕ входящее личное сообщение на tool-аккаунт
# (удобно для проверки мессенджера, пока аккаунты не прогреты для рассылки).
INBOX_ACCEPT_ANY_DM=

# --- Нейросеть (нейрокомментинг, имена, варианты рассылки, AI-редактор) ---
# Модель на класс задачи: "провайдер:модель".
#   FAST  — объём (нейрокомментинг, имена)
#   SMART — качество, редко (варианты рассылки, AI-редактор)
# Дефолт — OpenRouter (бесплатная модель, без карты), и для FAST, и для SMART.
# Groq пробовали раньше, но с некоторых сетей до него недоступно напрямую
# ("All connection attempts failed") — OpenRouter обычно доступнее.
# Gemini как провайдер убран (нет доступа к API). Grok (xAI) — опция, но
# платный, поэтому не дефолт; добавляется/убирается в api/llm.py по образцу
# grok/openrouter (это тот же OpenAI-совместимый путь).
LLM_FAST=openrouter:nvidia/nemotron-3-super-120b-a12b:free
LLM_SMART=openrouter:nvidia/nemotron-3-super-120b-a12b:free
# Запасные модели через запятую — берутся, если основная не ответила (лимит 429, сбой).
# Бесплатный OpenRouter даёт всего 50 запросов в сутки (1000, если пополнить на $10).
# Пример: LLM_FALLBACK=claude:claude-haiku-4-5   или   LLM_FALLBACK=groq:llama-3.3-70b-versatile
LLM_FALLBACK=

# Ключи (нужны только для выбранных провайдеров):
OPENROUTER_API_KEY=      # https://openrouter.ai/keys  (бесплатно, без карты)
GROQ_API_KEY=            # https://console.groq.com/keys  (бесплатно, но не у всех доступен)
XAI_API_KEY=             # https://console.x.ai  (Grok, платный)
DEEPSEEK_API_KEY=        # https://platform.deepseek.com  (почти даром, сильнейшая из этих)
ANTHROPIC_API_KEY=       # https://console.anthropic.com  (платно)

# Провайдеры: openrouter | groq | grok | claude | deepseek | cerebras | openai | ollama
# Примеры:
#   LLM_SMART=deepseek:deepseek-v4-pro
#   LLM_FAST=groq:llama-3.3-70b-versatile
#   LLM_FAST=ollama:qwen2.5:14b        (локально, OPENAI_BASE_URL не нужен)

# VK (необязательно): токен для чтения сообществ. Токены для рассылки добавляются в меню VK → 1.
VK_TOKEN=

# DarkStore (dark.shopping): ключ API для автопокупки аккаунтов. Заявка на доступ: https://dark.shopping/developer
DARKSTORE_API_KEY=

# Mini App «Клиент в один клик» (api/miniapp.py). Без токена Mini App выключено.
# Токен бота — от @BotFather. Публичный https-адрес сервера — без слэша в конце.
MINIAPP_BOT_TOKEN=
MINIAPP_PUBLIC_URL=
# Сколько сообщений дарить при первом входе (по умолчанию 10)
MINIAPP_GIFT=10
# Пакеты в Telegram Stars, JSON. Пусто — пакеты по умолчанию (цены-заглушки)
MINIAPP_PACKS=
# Операторы поддержки: Telegram-имена через запятую, без @. Покупатели их не видят: для них это
# просто «Поддержка». Оператор один раз открывает бота и нажимает Start, дальше отвечает на
# сообщения клиентов через Reply в этом же боте.
MINIAPP_OPERATORS=
# Пауза в секундах между сообщениями с одного аккаунта при нажатиях на большую кнопку (по умолчанию 25)
MINIAPP_TAP_GAP=25
# Сколько людей искать ЗАРАНЕЕ, пока покупатель не нажал (по умолчанию 2, 0 — выключить).
# Первый поиск по новому каналу идёт минуты: профиль, поиск чатов, чтение. Ждать их у
# спиннера покупатель не станет, поэтому человек ищется в паузу, пока нейронка пишет текст
# рассылки, а покупатель его читает и правит. На одном-двух аккаунтах ставь 0: прогрев
# расходует лимиты Telegram на тех, кто ещё ничего не нажал.
MINIAPP_PREWARM=2
# Пауза перед повторным прогревом канала, по которому никого не нашли (по умолчанию 900 с)
MINIAPP_PREWARM_RETRY=900
# Сессии, которым разрешён выход БЕЗ прокси — имена через запятую.
# Только для личного аккаунта на своей машине: он и так всегда ходит с этого IP.
# На сервере оставь ПУСТЫМ. Личный аккаунт, внезапно вышедший с серверного IP (да ещё из
# другой страны), для Telegram выглядит как угон — так уже умерли две сессии с
# AuthKeyDuplicated. Купленным аккаунтам прокси обязателен всегда: иначе все они ходят с
# одного IP, а это главный признак фермы.
DIRECT_SESSIONS=
