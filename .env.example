# --- LZT.market ---
# Токен API: lzt.market → Настройки → API. Требуется активный market-доступ +
# заданный пароль безопасности аккаунта, иначе API отвечает заглушкой
# «Вы должны установить пароль, чтобы продолжить».
LZT_TOKEN=
LZT_MARKET_ID=24
LZT_API_BASE_URL=https://prod-api.lzt.market

# --- Telegram (my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# telegramTool API — общий секрет, которым клиенты (десктоп-приложение) авторизуются.
# Необязательно: если оставить пустым, бэкенд сам сгенерирует токен при первом
# запуске и сохранит в ~/.telegramtool/token — десктоп-приложение прочитает
# его оттуда сам, вводить руками не придётся (см. api/auth.py).
API_TOKEN=

# Опционально: куда пушить входящие сообщения от tool-аккаунтов.
# Если задано, listener при старте подключает все sessions/ и шлёт каждое
# входящее личное сообщение в этот URL POST'ом.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# Хост/порт API (опционально)
API_HOST=0.0.0.0
API_PORT=9000

# Диалоги (/inbox): по умолчанию чат заводится только на ОТВЕТ на рассылку.
# Поставь 1, чтобы заводить чат на ЛЮБОЕ входящее личное сообщение на tool-аккаунт
# (удобно для проверки мессенджера, пока аккаунты не прогреты для рассылки).
INBOX_ACCEPT_ANY_DM=

# --- Нейросеть (нейрокомментинг, имена, варианты рассылки, AI-редактор) ---
# Модель на класс задачи: "провайдер:модель".
#   FAST  — объём (нейрокомментинг, имена)
#   SMART — качество, редко (варианты рассылки, AI-редактор)
# Дефолт — OpenRouter (бесплатная модель, без карты), и для FAST, и для SMART.
# Groq пробовали раньше, но с некоторых сетей до него недоступно напрямую
# ("All connection attempts failed") — OpenRouter обычно доступнее.
# Gemini как провайдер убран (нет доступа к API). Grok (xAI) — опция, но
# платный, поэтому не дефолт; добавляется/убирается в api/llm.py по образцу
# grok/openrouter (это тот же OpenAI-совместимый путь).
LLM_FAST=openrouter:nvidia/nemotron-3-super-120b-a12b:free
LLM_SMART=openrouter:nvidia/nemotron-3-super-120b-a12b:free

# Ключи (нужны только для выбранных провайдеров):
OPENROUTER_API_KEY=      # https://openrouter.ai/keys  (бесплатно, без карты)
GROQ_API_KEY=            # https://console.groq.com/keys  (бесплатно, но не у всех доступен)
XAI_API_KEY=             # https://console.x.ai  (Grok, платный)
DEEPSEEK_API_KEY=        # https://platform.deepseek.com  (почти даром, сильнейшая из этих)
ANTHROPIC_API_KEY=       # https://console.anthropic.com  (платно)

# Провайдеры: openrouter | groq | grok | claude | deepseek | cerebras | openai | ollama
# Примеры:
#   LLM_SMART=deepseek:deepseek-v4-pro
#   LLM_FAST=groq:llama-3.3-70b-versatile
#   LLM_FAST=ollama:qwen2.5:14b        (локально, OPENAI_BASE_URL не нужен)
